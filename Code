        <button data-action="set-status" data-status="active" class="tactile rounded-xl glass py-2 text-xs font-semibold hover:border-mint-500/40">Mark Active</button>
        <button data-action="set-status" data-status="resolved" class="tactile rounded-xl glass py-2 text-xs font-semibold hover:border-ink-300/40">Mark Resolved</button>
        <button data-action="set-status" data-status="won" class="tactile rounded-xl glass py-2 text-xs font-semibold text-mint-400 hover:border-mint-500/40">Mark Won</button>
        <button data-action="set-status" data-status="lost" class="tactile rounded-xl glass py-2 text-xs font-semibold text-coral-400 hover:border-coral-500/40">Mark Lost</button>
        <button data-action="delete-card" class="tactile col-span-2 rounded-xl glass py-2 text-xs font-semibold text-coral-400 hover:bg-coral-500/10">Delete market</button>
      </div>
    </div>
  </article>
</template>

<script>
(function () {
  'use strict';

  /* ================================================================
     GLOBAL ERROR NET — if anything throws anywhere in this script,
     surface it visibly instead of failing silently (a silent JS
     error earlier in the file is the classic cause of "the button
     just does nothing").
     ================================================================ */
  window.addEventListener('error', function (e) {
    try {
      console.error('Pulse runtime error:', e.error || e.message, e.filename, e.lineno);
      var t = document.getElementById('toast');
      if (t) {
        var inner = t.querySelector('div');
        if (inner) inner.textContent = 'App error — open console (F12) for details';
        t.classList.remove('hidden');
      }
    } catch (_) { /* never let the error handler itself throw */ }
  });

  /* ================================================================
     PWA MANIFEST — generated at runtime as a Blob.
     ================================================================ */
  try {
    const manifest = {
      name: 'Pulse — Live Odds Board', short_name: 'Pulse', start_url: '.', display: 'standalone',
      background_color: '#080B14', theme_color: '#080B14',
      icons: [{
        src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'%3E%3Crect width='120' height='120' rx='28' fill='%230B0F1A'/%3E%3Cpath d='M14 62 L38 62 L48 32 L64 92 L76 50 L86 62 L106 62' stroke='%2300F5A0' stroke-width='8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E",
        sizes: '120x120', type: 'image/svg+xml'
      }]
    };
    const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
    const manifestLink = document.createElement('link');
    manifestLink.rel = 'manifest';
    manifestLink.href = URL.createObjectURL(manifestBlob);
    document.head.appendChild(manifestLink);
  } catch (e) { /* manifest is a progressive enhancement — never block the app */ }

  /* ================================================================
     MATH ENGINE — pure, framework-free, portable to Swift/RN as-is.
     ================================================================ */
  const OddsMath = {
    clampProb(p) {
      p = Number(p);
      if (Number.isNaN(p)) return 0.5;
      return Math.min(0.99, Math.max(0.01, p));
    },
    decimalFromProbability(p) { return 1 / OddsMath.clampProb(p); },
    probabilityFromDecimal(o) { return o <= 1 ? 0.99 : OddsMath.clampProb(1 / o); },

    americanFromProbability(p) {
      p = OddsMath.clampProb(p);
      return p >= 0.5 ? Math.round(-100 * (p / (1 - p))) : Math.round(100 * ((1 - p) / p));
    },
    probabilityFromAmerican(a) {
      return a < 0 ? OddsMath.clampProb((-a) / ((-a) + 100)) : OddsMath.clampProb(100 / (a + 100));
    },

    sigmoid(x) { return 1 / (1 + Math.exp(-x)); },
    // Casual model: sum of 3 weighted -5..5 inputs -> sigmoid -> clamp(0.01,0.99)
    casualEstimate(w1, w2, w3) {
      const SCALE = 0.35; // tune sensitivity here
      const sum = (Number(w1) || 0) + (Number(w2) || 0) + (Number(w3) || 0);
      return OddsMath.clampProb(OddsMath.sigmoid(sum * SCALE));
    },

    poissonPMF(k, lambda) {
      let factorial = 1;
      for (let i = 2; i <= k; i++) factorial *= i;
      return (Math.pow(lambda, k) * Math.exp(-lambda)) / factorial;
    },
    // Quant model: Poisson joint-grid win probability for lambda A vs lambda B
    quantEstimate(lambdaA, lambdaB) {
      lambdaA = Math.max(0, Number(lambdaA) || 0);
      lambdaB = Math.max(0, Number(lambdaB) || 0);
      const MAX = 12;
      let pAWins = 0;
      for (let a = 0; a <= MAX; a++) {
        const pa = OddsMath.poissonPMF(a, lambdaA);
        for (let b = 0; b < a; b++) pAWins += pa * OddsMath.poissonPMF(b, lambdaB);
      }
      return OddsMath.clampProb(pAWins);
    },
  };

  /* ================================================================
     STATE + PERSISTENCE
     ================================================================ */
  const STORAGE_KEY = 'pulse.cards.v2';
  const THEME_KEY = 'pulse.theme';

  const Store = {
    load() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) { console.warn('Pulse: could not read localStorage', e); return []; }
    },
    save(list) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); }
      catch (e) { console.warn('Pulse: could not write localStorage', e); showToast('Storage full — could not save'); }
    }
  };

  /** @type {Array<{id:string,name:string,prob:number,prevProb:number,status:string,createdAt:number,updatedAt:number}>} */
  let cards = Store.load();

  function uid() { return 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }

  function findCard(id) { return cards.find(c => c.id === id); }

  function saveCard(card) {
    const i = cards.findIndex(c => c.id === card.id);
    if (i === -1) cards.unshift(card); else cards[i] = card;
    Store.save(cards);
  }
  function deleteCard(id) {
    cards = cards.filter(c => c.id !== id);
    Store.save(cards);
  }

  /* ================================================================
     DOM REFERENCES
     ================================================================ */
  const board = document.getElementById('board');
  const emptyState = document.getElementById('emptyState');
  const cardTemplate = document.getElementById('cardTemplate');

  /* ================================================================
     FORMATTERS
     ================================================================ */
  function fmtPct(p) { return Math.round(p * 100) + '%'; }
  function fmtDecimal(p) { return OddsMath.decimalFromProbability(p).toFixed(2); }
  function fmtAmerican(p) {
    const a = OddsMath.americanFromProbability(p);
    return (a > 0 ? '+' : '') + a;
  }
  function relTime(ts) {
    const diff = Date.now() - ts;
    const m = Math.floor(diff / 60000);
    if (m < 1) return 'just now';
    if (m < 60) return m + 'm ago';
    const h = Math.floor(m / 60);
    if (h < 24) return h + 'h ago';
    return Math.floor(h / 24) + 'd ago';
  }
  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
  }

  const STATUS_META = {
    active:   { label: 'Live',     badge: 'bg-mint-500/15 text-mint-400 border border-mint-500/30' },
    resolved: { label: 'Resolved', badge: 'bg-ink-300/15 text-ink-300 border border-ink-300/25' },
    won:      { label: 'Won',      badge: 'bg-mint-500/20 text-mint-300 border border-mint-500/40' },
    lost:     { label: 'Lost',     badge: 'bg-coral-500/15 text-coral-400 border border-coral-500/30' },
  };

  /* ================================================================
     RENDER — full re-render, but all interaction is delegated so
     nothing needs re-binding after a re-render (this is what makes
     the whole board robust against stale-listener bugs).
     ================================================================ */
  function renderBoard() {
    const live = cards.filter(c => c.status === 'active').sort((a, b) => b.updatedAt - a.updatedAt);
    board.innerHTML = '';
    emptyState.classList.toggle('hidden', live.length > 0);
    live.forEach(c => board.appendChild(buildCardNode(c)));
  }

  function buildCardNode(card) {
    const node = cardTemplate.content.firstElementChild.cloneNode(true);
    node.dataset.id = card.id;
    node.classList.add('status-' + card.status);
    paintCard(node, card, { silent: true });
    return node;
  }

  function paintCard(node, card, opts) {
    opts = opts || {};
    node.querySelector('.event-name').textContent = card.name;
    node.querySelector('.status-line').textContent = `Updated ${relTime(card.updatedAt)}`;

    const meta = STATUS_META[card.status] || STATUS_META.active;
    const badge = node.querySelector('.statusBadge');
    badge.className = 'statusBadge inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ' + meta.badge;
    badge.textContent = meta.label;

    node.querySelector('.decimal-value').textContent = fmtDecimal(card.prob) + 'x';
    node.querySelector('.prob-value').textContent = fmtPct(card.prob) + ' chance';
    node.querySelector('.american-value').textContent = fmtAmerican(card.prob) + ' ML';
    node.querySelector('.meter-fill').style.width = (card.prob * 100).toFixed(0) + '%';

    const slider = node.querySelector('.probSlider');
    if (document.activeElement !== slider) slider.value = Math.round(card.prob * 100);

    // Trend tag + flash micro-animation
    const trendTag = node.querySelector('.trendTag');
    if (!opts.silent && typeof card.prevProb === 'number' && card.prevProb !== card.prob) {
      const up = card.prob > card.prevProb;
      trendTag.classList.remove('hidden');
      trendTag.textContent = (up ? '▲ ' : '▼ ') + Math.abs(Math.round((card.prob - card.prevProb) * 100)) + '%';
      trendTag.className = 'trendTag inline-flex items-center gap-0.5 text-[11px] font-bold ' + (up ? 'text-mint-400' : 'text-coral-400');
      const zone = node.querySelector('.numberZone');
      zone.classList.remove('flash-up', 'flash-down');
      void zone.offsetWidth; // restart animation
      zone.classList.add(up ? 'flash-up' : 'flash-down');
    } else if (opts.silent) {
      trendTag.classList.add('hidden');
    }
  }

  function stepProb(card, dir) {
    card.prevProb = card.prob;
    card.prob = OddsMath.clampProb(card.prob + dir * 0.01);
    card.updatedAt = Date.now();
    saveCard(card);
    refreshCardById(card.id);
  }

  function refreshCardById(id) {
    const node = board.querySelector(`.market-card[data-id="${id}"]`);
    const card = findCard(id);
    if (node && card) {
      node.className = node.className.replace(/status-\w+/g, '').trim();
      node.classList.add('market-card', 'glass', 'rounded-3xl', 'p-4', 'status-' + card.status);
      paintCard(node, card);
    } else {
      renderBoard();
    }
  }

  /* ================================================================
     QUICK ADD / SMART BUILD — creation pipeline (bug fix target)
     ================================================================ */
  const quickAddForm = document.getElementById('quickAddForm');
  const quickAddInput = document.getElementById('quickAddInput');
  const buildPanel = document.getElementById('buildPanel');
  const segBtns = document.querySelectorAll('.segBtn');
  const segThumb = document.getElementById('segThumb');
  let createMode = 'quick';
  let buildEstMode = 'casual';

  function setCreateMode(mode) {
    createMode = mode;
    segBtns.forEach(b => {
      const active = b.dataset.seg === mode;
      b.classList.toggle('text-ink-950', active);
      b.classList.toggle('text-ink-300', !active);
    });
    segThumb.style.transform = mode === 'quick' ? 'translateX(0)' : 'translateX(100%)';
    setCollapse(buildPanel, mode === 'estimate');
    quickAddInput.placeholder = mode === 'quick'
      ? 'New market — e.g. “Rain before kickoff”'
      : 'Name this market, then tune it below';
  }
  segBtns.forEach(b => b.addEventListener('click', () => setCreateMode(b.dataset.seg)));
  setCreateMode('quick');

  document.querySelectorAll('.bModeBtn').forEach(b => {
    b.addEventListener('click', () => {
      buildEstMode = b.dataset.bmode;
      document.querySelectorAll('.bModeBtn').forEach(x => {
        x.classList.toggle('bg-mint-500', x === b);
        x.classList.toggle('text-ink-950', x === b);
      });
      document.getElementById('buildCasual').classList.toggle('hidden', buildEstMode !== 'casual');
      document.getElementById('buildQuant').classList.toggle('hidden', buildEstMode !== 'quant');
      updateBuildPreview();
    });
  });
  document.querySelector('.bModeBtn[data-bmode="casual"]').classList.add('bg-mint-500', 'text-ink-950');

  ['bw1', 'bw2', 'bw3'].forEach((id, idx) => {
    const input = document.getElementById(id);
    const label = document.getElementById('bv' + (idx + 1));
    input.addEventListener('input', () => { label.textContent = input.value; updateBuildPreview(); });
  });
  document.getElementById('blamA').addEventListener('input', updateBuildPreview);
  document.getElementById('blamB').addEventListener('input', updateBuildPreview);

  function computeBuildProbability() {
    if (buildEstMode === 'casual') {
      return OddsMath.casualEstimate(
        document.getElementById('bw1').value,
        document.getElementById('bw2').value,
        document.getElementById('bw3').value
      );
    }
    return OddsMath.quantEstimate(
      document.getElementById('blamA').value,
      document.getElementById('blamB').value
    );
  }
  function updateBuildPreview() {
    document.getElementById('buildPreview').textContent = fmtPct(computeBuildProbability());
  }
  updateBuildPreview();

  // --- THE FIX: single robust submit handler for the creation form ---
  quickAddForm.addEventListener('submit', function (e) {
    e.preventDefault();
    e.stopPropagation();
    console.log('Pulse: create-market submit fired, mode =', createMode);

    const rawName = quickAddInput.value;
    const name = (rawName || '').trim();
    if (!name) {
      // Native "required" validation is intentionally disabled (see <form novalidate>)
      // because it silently swallows the submit event with no visible feedback in
      // this custom glass UI. We surface the same problem ourselves instead.
      quickAddInput.classList.remove('input-shake');
      void quickAddInput.offsetWidth; // restart animation if triggered twice in a row
      quickAddInput.classList.add('input-shake', 'input-error');
      quickAddInput.focus();
      showToast('Name your market first');
      setTimeout(() => quickAddInput.classList.remove('input-shake'), 460);
      quickAddInput.addEventListener('input', function clearError() {
        quickAddInput.classList.remove('input-error');
        quickAddInput.removeEventListener('input', clearError);
      }, { once: true });
      return;
    }

    const initialProb = createMode === 'estimate' ? computeBuildProbability() : 0.5;

    const card = {
      id: uid(),
      name: name,
      prob: OddsMath.clampProb(initialProb),
      prevProb: OddsMath.clampProb(initialProb),
      status: 'active',
      createdAt: Date.now(),
      updatedAt: Date.now(),
    };

    saveCard(card);
    renderBoard();

    quickAddInput.value = '';
    if (createMode === 'estimate') {
      // reset build inputs back to neutral for the next market
      ['bw1', 'bw2', 'bw3'].forEach(id => { document.getElementById(id).value = 0; });
      document.getElementById('bv1').textContent = '0';
      document.getElementById('bv2').textContent = '0';
      document.getElementById('bv3').textContent = '0';
      updateBuildPreview();
    }
    quickAddInput.focus();
    showToast(`Market opened: “${name}”`);
  });

  /* ================================================================
     EVENT DELEGATION on the board — click + input, so every card
     (including ones added after page load) works without needing
     to re-bind per-card listeners.
     ================================================================ */
  board.addEventListener('click', function (e) {
    const actionEl = e.target.closest('[data-action]');
    if (!actionEl) return;
    const cardNode = e.target.closest('.market-card');
    if (!cardNode) return;
    const id = cardNode.dataset.id;
    const card = findCard(id);
    if (!card) return;

    const action = actionEl.dataset.action;

    if (action === 'step-down' || action === 'step-up') {
      stepProb(card, action === 'step-up' ? 1 : -1);
      return;
    }

    if (action === 'toggle-est') {
      setCollapse(cardNode.querySelector('.estimatorPanel'), 'toggle');
      setCollapse(cardNode.querySelector('.cardMenu'), false);
      return;
    }

    if (action === 'toggle-menu') {
      setCollapse(cardNode.querySelector('.cardMenu'), 'toggle');
      setCollapse(cardNode.querySelector('.estimatorPanel'), false);
      return;
    }

    if (action === 'est-mode') {
      const mode = actionEl.dataset.mode;
      cardNode.querySelectorAll('.modeBtn').forEach(b => {
        const active = b === actionEl;
        b.classList.toggle('bg-mint-500', active);
        b.classList.toggle('text-ink-950', active);
      });
      cardNode.querySelector('.casualInputs').classList.toggle('hidden', mode !== 'casual');
      cardNode.querySelector('.quantInputs').classList.toggle('hidden', mode !== 'quant');
      cardNode.dataset.estMode = mode;
      return;
    }

    if (action === 'apply-estimate') {
      const mode = cardNode.dataset.estMode || 'casual';
      let p;
      if (mode === 'casual') {
        p = OddsMath.casualEstimate(
          cardNode.querySelector('.w1').value,
          cardNode.querySelector('.w2').value,
          cardNode.querySelector('.w3').value
        );
      } else {
        p = OddsMath.quantEstimate(
          cardNode.querySelector('.lamA').value,
          cardNode.querySelector('.lamB').value
        );
      }
      card.prevProb = card.prob;
      card.prob = p;
      card.updatedAt = Date.now();
      saveCard(card);
      refreshCardById(card.id);
      setCollapse(cardNode.querySelector('.estimatorPanel'), false);
      showToast('Estimate applied');
      return;
    }

    if (action === 'set-status') {
      card.status = actionEl.dataset.status;
      card.updatedAt = Date.now();
      saveCard(card);
      renderBoard();
      showToast(`“${card.name}” marked ${actionEl.dataset.status}`);
      return;
    }

    if (action === 'delete-card') {
      deleteCard(card.id);
      renderBoard();
      showToast('Market deleted');
      return;
    }
  });

  // Live probability slider (delegated 'input' — bubbles, so this
  // fires continuously while dragging on every card, old and new).
  board.addEventListener('input', function (e) {
    const target = e.target;
    const cardNode = e.target.closest('.market-card');
    if (!cardNode) return;
    const card = findCard(cardNode.dataset.id);
    if (!card) return;

    if (target.classList.contains('probSlider')) {
      card.prob = OddsMath.clampProb(Number(target.value) / 100);
      card.updatedAt = Date.now();
      paintCard(cardNode, card, { silent: true });
      return;
    }
    if (target.classList.contains('wSlider')) {
      const label = target.classList.contains('w1') ? cardNode.querySelector('.v1')
                  : target.classList.contains('w2') ? cardNode.querySelector('.v2')
                  : cardNode.querySelector('.v3');
      if (label) label.textContent = target.value;
      return;
    }
  });

  // Commit slider value to storage once the drag ends (change fires on release)
  board.addEventListener('change', function (e) {
    if (!e.target.classList.contains('probSlider')) return;
    const cardNode = e.target.closest('.market-card');
    const card = findCard(cardNode && cardNode.dataset.id);
    if (!card) return;
    saveCard(card);
  });

  function setCollapse(panel, mode) {
    if (!panel) return;
    const isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px';
    const open = mode === 'toggle' ? !isOpen : !!mode;
    panel.style.maxHeight = open ? panel.scrollHeight + 'px' : '0px';
    panel.style.opacity = open ? '1' : '0';
  }

  /* ================================================================
     THEME
     ================================================================ */
  const root = document.documentElement;
  const iconMoon = document.getElementById('iconMoon');
  const iconSun = document.getElementById('iconSun');

  function applyTheme(theme) {
    root.classList.toggle('dark', theme === 'dark');
    root.classList.toggle('light', theme === 'light');
    document.body.classList.toggle('bg-ink-950', theme === 'dark');
    document.body.classList.toggle('bg-ink-50', theme === 'light');
    document.body.classList.toggle('text-ink-50', theme === 'dark');
    document.body.classList.toggle('text-ink-900', theme === 'light');
    iconMoon.classList.toggle('hidden', theme !== 'dark');
    iconSun.classList.toggle('hidden', theme !== 'light');
    localStorage.setItem(THEME_KEY, theme);
  }
  const storedTheme = localStorage.getItem(THEME_KEY);
  const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(storedTheme || (systemPrefersDark ? 'dark' : 'light'));
  document.getElementById('themeToggle').addEventListener('click', () => {
    applyTheme(root.classList.contains('dark') ? 'light' : 'dark');
  });

  /* ================================================================
     ARCHIVE / HISTORY DRAWER
     ================================================================ */
  const historyOverlay = document.getElementById('historyOverlay');
  const historyPanel = document.getElementById('historyPanel');
  const historyList = document.getElementById('historyList');
  const historySearch = document.getElementById('historySearch');
  let activeFilter = 'all';

  function openHistory() {
    historyOverlay.classList.remove('hidden');
    requestAnimationFrame(() => historyPanel.classList.remove('translate-y-full'));
    renderHistory();
  }
  function closeHistoryFn() {
    historyPanel.classList.add('translate-y-full');
    setTimeout(() => historyOverlay.classList.add('hidden'), 300);
  }
  document.getElementById('historyToggle').addEventListener('click', openHistory);
  document.getElementById('closeHistory').addEventListener('click', closeHistoryFn);
  document.getElementById('historyBackdrop').addEventListener('click', closeHistoryFn);

  document.getElementById('historyFilters').addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-chip');
    if (!btn) return;
    activeFilter = btn.dataset.filter;
    document.querySelectorAll('.filter-chip').forEach(c => {
      c.classList.toggle('bg-mint-500', c === btn);
      c.classList.toggle('text-ink-950', c === btn);
    });
    renderHistory();
  });
  historySearch.addEventListener('input', renderHistory);

  function renderHistory() {
    const q = historySearch.value.trim().toLowerCase();
    let list = [...cards].sort((a, b) => b.updatedAt - a.updatedAt);
    if (activeFilter !== 'all') list = list.filter(c => c.status === activeFilter);
    if (q) list = list.filter(c => c.name.toLowerCase().includes(q));

    historyList.innerHTML = '';
    if (list.length === 0) {
      historyList.innerHTML = '<p class="text-center text-ink-400 text-sm py-10">No matching markets.</p>';
      return;
    }
    list.forEach(card => {
      const meta = STATUS_META[card.status] || STATUS_META.active;
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-3 rounded-xl glass px-3.5 py-3';
      row.innerHTML = `
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 mb-0.5">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide ${meta.badge}">${meta.label}</span>
            <span class="text-[11px] text-ink-400">${relTime(card.updatedAt)}</span>
          </div>
          <p class="text-sm font-semibold truncate">${escapeHtml(card.name)}</p>
          <p class="text-[11px] text-ink-400 font-mono">${fmtDecimal(card.prob)}x · ${fmtPct(card.prob)}</p>
        </div>
        <button data-id="${card.id}" class="histDelete tactile shrink-0 w-8 h-8 rounded-full glass flex items-center justify-center text-coral-400" aria-label="Delete">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
        </button>`;
      historyList.appendChild(row);
    });
    historyList.querySelectorAll('.histDelete').forEach(btn => {
      btn.addEventListener('click', () => {
        deleteCard(btn.dataset.id);
        renderHistory();
        renderBoard();
      });
    });
  }

  /* ================================================================
     JSON EXPORT / IMPORT
     ================================================================ */
  document.getElementById('exportBtn').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(cards, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pulse-export-${new Date().toISOString().slice(0, 10)}.json`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    showToast('Exported JSON');
  });

  document.getElementById('importInput').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const incoming = JSON.parse(reader.result);
        if (!Array.isArray(incoming)) throw new Error('bad format');
        const existingIds = new Set(cards.map(c => c.id));
        let added = 0;
        incoming.forEach(c => {
          if (c && c.id && c.name && !existingIds.has(c.id)) {
            cards.push({
              id: c.id, name: String(c.name), prob: OddsMath.clampProb(c.prob),
              prevProb: OddsMath.clampProb(c.prevProb != null ? c.prevProb : c.prob),
              status: STATUS_META[c.status] ? c.status : 'active',
              createdAt: c.createdAt || Date.now(), updatedAt: c.updatedAt || Date.now(),
            });
            added++;
          }
        });
        Store.save(cards);
        renderBoard();
        renderHistory();
        showToast(`Imported ${added} market(s)`);
      } catch (err) {
        showToast('Import failed — invalid JSON');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  /* ================================================================
     TOAST
     ================================================================ */
  let toastTimer = null;
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.querySelector('div').textContent = msg;
    toast.classList.remove('hidden');
    toast.classList.remove('pop-in'); void toast.offsetWidth; toast.classList.add('pop-in');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.add('hidden'), 2200);
  }

  /* ================================================================
     INIT
     ================================================================ */
  renderBoard();
})();
</script>

<!--
  ============================================================
  MIGRATION NOTES (native codebase readiness)
  ============================================================
  STATE      -> `cards` array + `Store` object. Maps to a Codable
                struct + UserDefaults, or AsyncStorage, in a
                native rewrite.
  MATH       -> `OddsMath`. Pure functions, no DOM/storage
                dependencies — copy verbatim into Swift statics
                or a JS module.
  RENDERING  -> everything touching `document.*` / event
                delegation on `board`. The only layer that needs
                a per-platform rewrite (SwiftUI views / React
                Native components); it never contains business
                logic itself, only calls into OddsMath and Store.
  ============================================================
-->
</body>
</html>