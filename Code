<style>
  html { -webkit-text-size-adjust: 100%; }
  body { -webkit-tap-highlight-color: transparent; overscroll-behavior-y: none; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-thumb { background: rgba(0,245,160,0.18); border-radius: 8px; }

  /* ---------- Glass surfaces ---------- */
  .glass {
    background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.02));
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .light .glass {
    background: linear-gradient(180deg, rgba(255,255,255,0.75), rgba(255,255,255,0.5));
    border: 1px solid rgba(15,19,32,0.08);
  }
  .glass-strong {
    background: linear-gradient(180deg, rgba(20,24,38,0.86), rgba(12,15,24,0.92));
    -webkit-backdrop-filter: blur(26px) saturate(170%);
    backdrop-filter: blur(26px) saturate(170%);
    border: 1px solid rgba(255,255,255,0.09);
  }
  .light .glass-strong {
    background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.82));
    border: 1px solid rgba(15,19,32,0.08);
  }

  /* ---------- Glow ring for "live" market cards ---------- */
  .market-card {
    position: relative;
    transition: transform 0.22s cubic-bezier(.2,.9,.3,1.3), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .market-card::before {
    content: '';
    position: absolute; inset: -1px; border-radius: inherit; padding: 1px;
    background: linear-gradient(135deg, rgba(0,245,160,0.35), rgba(139,108,255,0.18), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    pointer-events: none; opacity: 0.7;
  }
  .market-card.status-won::before   { background: linear-gradient(135deg, rgba(0,245,160,0.6), transparent 60%); }
  .market-card.status-lost::before  { background: linear-gradient(135deg, rgba(255,92,108,0.55), transparent 60%); }
  .market-card.status-resolved::before { background: linear-gradient(135deg, rgba(124,135,166,0.4), transparent 60%); }

  /* ---------- Flash micro-animation on odds movement ---------- */
  @keyframes flashUp   { 0% { background-color: rgba(0,245,160,0.22); } 100% { background-color: transparent; } }
  @keyframes flashDown { 0% { background-color: rgba(255,92,108,0.22); } 100% { background-color: transparent; } }
  .flash-up   { animation: flashUp 0.7s ease-out; }
  .flash-down { animation: flashDown 0.7s ease-out; }

  /* ---------- Live pulse dot ---------- */
  .live-dot { position: relative; }
  .live-dot::after {
    content: ''; position: absolute; inset: -5px; border-radius: 999px;
    background: currentColor; opacity: 0.4; animation: pulseRing 1.7s ease-out infinite;
  }
  @keyframes pulseRing { 0% { transform: scale(0.55); opacity: 0.55; } 100% { transform: scale(2.3); opacity: 0; } }

  /* ---------- Liquidity / probability meter ---------- */
  .meter-track { height: 10px; border-radius: 999px; overflow: hidden; background: rgba(255,92,108,0.28); display: flex; }
  .meter-fill { background: linear-gradient(90deg, #00CC85, #3CFFB4); transition: width 0.45s cubic-bezier(.2,.9,.3,1.1); }

  /* ---------- Sliders ---------- */
  input[type="range"] { -webkit-appearance: none; appearance: none; background: transparent; }
  input[type="range"]::-webkit-slider-runnable-track { height: 6px; border-radius: 999px; background: rgba(255,255,255,0.12); }
  .light input[type="range"]::-webkit-slider-runnable-track { background: rgba(15,19,32,0.12); }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 24px; height: 24px; margin-top: -9px;
    border-radius: 999px; background: radial-gradient(circle at 35% 30%, #7DFFCB, #00CC85);
    border: 3px solid #080B14; box-shadow: 0 2px 10px rgba(0,245,160,0.45);
    transition: transform 0.15s cubic-bezier(.3,1.5,.5,1);
  }
  input[type="range"]:active::-webkit-slider-thumb { transform: scale(1.18); }
  .light input[type="range"]::-webkit-slider-thumb { border-color: #F4F6FB; }
  input[type="range"]::-moz-range-track { height: 6px; border-radius: 999px; background: rgba(255,255,255,0.12); }
  input[type="range"]::-moz-range-thumb {
    width: 20px; height: 20px; border-radius: 999px; background: #00F5A0; border: 3px solid #080B14;
  }

  /* ---------- Tactile buttons ---------- */
  .tactile { transition: transform 0.14s cubic-bezier(.3,1.6,.5,1), background-color 0.2s ease, box-shadow 0.2s ease; }
  .tactile:active { transform: scale(0.92); }
  .thumb-btn { min-width: 44px; min-height: 44px; }

  /* ---------- Empty-name feedback (replaces silent native validation) ---------- */
  @keyframes shakeX {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
  }
  .input-shake { animation: shakeX 0.45s cubic-bezier(.36,.07,.19,.97) both; }
  .input-error { border-color: rgba(255,92,108,0.7) !important; box-shadow: 0 0 0 3px rgba(255,92,108,0.18); }

  .fade-in { animation: fadeIn 0.3s cubic-bezier(.2,.85,.3,1.15) both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }

  .pop-in { animation: popIn 0.42s cubic-bezier(.24,1.4,.4,1) both; }
  @keyframes popIn { 0% { opacity: 0; transform: scale(0.85) translateY(8px); } 100% { opacity: 1; transform: scale(1) translateY(0); } }

  .card-collapse { transition: max-height 0.34s cubic-bezier(.2,.85,.3,1.1), opacity 0.24s ease; overflow: hidden; }

  /* ---------- Segmented toggle ---------- */
  .seg-btn { transition: color 0.25s ease; }
  .seg-thumb { transition: transform 0.28s cubic-bezier(.2,.9,.3,1.25); }

  @media (prefers-reduced-motion: reduce) {
    .live-dot::after { animation: none; display: none; }
    * { transition-duration: 0.001ms !important; animation-duration: 0.001ms !important; }
  }
</style>
</head>

